<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A copy of Marknote's theme model (MarkdownViewer/Services/Theming, minus
    the one WinUI file) and its lint, so a pull request from anyone can be
    checked exactly as the app checks a theme. Synced from the Marknote repo
    by tools/Sync-ThemeLint.ps1 there; do not edit here.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ThemeLint</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
</Project>
